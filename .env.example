# Copy to .env. Variables ending with _PASSWORD, _SECRET, or _FERNET_KEY are auto-generated if empty;
# others must be filled in manually. Existing values remain unchanged on re-init.

# Set these before `task bootstrap`.

# Private key of a funded EVM account on the LINKS chain (64 hex chars, no 0x)
TRUST_L2_PRIVATE_KEY=
# Wallet mnemonics. Generate each one with:
# docker run --rm --entrypoint gen-mnemonic ghcr.io/moderate-project/trust-service:latest
TRUST_MNEMONIC=
TRUST_KEY_STORAGE_MNEMONIC=

# Auto-generated. Keep after first start.
TRUST_STRONGHOLD_PASSWORD=
TRUST_KEY_STORAGE_STRONGHOLD_PASSWORD=
OPENMETADATA_FERNET_KEY=
