# Copy to .env. Variables ending with _PASSWORD, _SECRET, or _FERNET_KEY are auto-generated if empty;
# others must be filled in manually. Existing values remain unchanged on re-init.

# Set these before `task bootstrap`.
DOMAIN=
S3_ACCESS_KEY=moderate
# Wallet mnemonics. Generate each one with:
# docker run --rm --entrypoint gen-mnemonic ghcr.io/moderate-project/trust-service:sha-15f883c
# Copy the words after "Mnemonic:" into each variable.
TRUST_MNEMONIC=
TRUST_KEY_STORAGE_MNEMONIC=

# Auto-generated. Keep after first start.
TRUST_STRONGHOLD_PASSWORD=
TRUST_KEY_STORAGE_STRONGHOLD_PASSWORD=
OPENMETADATA_FERNET_KEY=
POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
OPENMETADATA_DB_PASSWORD=
API_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
PLATFORM_ADMIN_PASSWORD=
WORKFLOWS_PASSWORD=
APISIX_CLIENT_SECRET=
RABBITMQ_PASSWORD=
MONGO_ROOT_PASSWORD=
S3_SECRET=
GEOSERVER_ADMIN_PASSWORD=

# Add the ingestion-bot token after the first start; see README.md.
# OPENMETADATA_BOT_TOKEN=
